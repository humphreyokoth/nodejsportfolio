rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'message', 'createdAt', 'userAgent', 'page'
      ])
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.message is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.email.size() > 0
      && request.resource.data.email.size() <= 200
      && request.resource.data.message.size() > 0
      && request.resource.data.message.size() <= 4000;

      allow read, update, delete: if false;
    }

    match /recipes/{docId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'mealType', 'title', 'notes', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.mealType is string
      && (request.resource.data.mealType == 'breakfast'
          || request.resource.data.mealType == 'lunch'
          || request.resource.data.mealType == 'dinner')
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.notes is string
      && request.resource.data.notes.size() <= 1500;

      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
